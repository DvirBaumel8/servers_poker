# =============================================================
# BotRoyale Backend — Production Environment (Oracle ARM)
# Copy to /opt/botroyale/.env.production on the server.
# NEVER commit the real file to git.
# =============================================================

# ─── Server ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_NAME=BotRoyale

# Express trust proxy — REQUIRED when nginx is in front.
# Without this, rate-limiter sees nginx's IP instead of the real client IP.
TRUST_PROXY=1

# ─── Database (Supabase or Neon — external managed Postgres) ──
# Supabase example: db.xxxxxxxxxxxx.supabase.co
# Neon example:    ep-xxx-yyy.us-east-2.aws.neon.tech
DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_NAME=postgres
DB_SSL=true
# Pool size: 10 is conservative for free tier connection limits.
# Supabase free: 60 connections max; Neon free: 100 pooler connections.
DB_POOL_SIZE=10

# ─── Authentication ───────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be 64+ characters. Application exits on startup if this is missing or equals "change-me-in-production".
JWT_SECRET=CHANGE_ME_64_PLUS_CHAR_RANDOM_HEX_STRING_HERE
JWT_EXPIRES_IN=24h

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Must match your Vercel URL exactly.
# No trailing slash. Add your custom domain once set up.
CORS_ORIGINS=https://your-app.vercel.app,https://yourdomain.com

# ─── Redis (internal docker network — service name as host) ───
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=poker:

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# Must be false in production — only localhost bypass in dev
RATE_LIMIT_SKIP_LOCALHOST=false

# ─── Game State / Recovery ────────────────────────────────────
GAME_STATE_PERSISTENCE=true
GAME_STATE_PERSIST_INTERVAL_MS=5000
GAME_STATE_CLEANUP_INTERVAL_MS=3600000
GAME_STATE_RECOVERY_WINDOW_MINUTES=30
GAME_AUTO_RECOVER=true
GAME_RECOVERY_DELAY_MS=5000

# ─── Worker Threads ───────────────────────────────────────────
# Recommended: enable on Oracle ARM 4 OCPU instance
ENABLE_WORKER_THREADS=true
MAX_CONCURRENT_GAMES=100
WORKER_TIMEOUT=30000

# ─── Redis Pub/Sub ────────────────────────────────────────────
REDIS_PUBSUB_POLL_MS=100

# ─── Instance / Scaling ───────────────────────────────────────
# Unique ID for this instance (useful if you scale to 2+ instances later)
# INSTANCE_ID=oracle-arm-1
GAME_OWNERSHIP_TTL_MS=10000
GAME_OWNERSHIP_RENEWAL_MS=3000

# ─── Tournament Scheduler ─────────────────────────────────────
TOURNAMENT_SCHEDULER_ENABLED=true
TOURNAMENT_SCHEDULER_CRON=*/30 * * * * *
TOURNAMENT_SCHEDULER_INTERVAL_MS=30000

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=/app/logs

# ─── Email (optional) ─────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=alerts@yourdomain.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=noreply@yourdomain.com

# ─── S3 Archiving (optional — for cold storage of hand history) ─
# AWS_S3_BUCKET=botroyale-archive
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── GitHub image reference (used by docker-compose.prod.yml) ─
# Set this to your actual GitHub org/repo (all lowercase)
GITHUB_REPOSITORY=your-github-org/servers_poker
