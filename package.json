{
  "name": "poker-engine",
  "version": "1.0.0",
  "description": "No-limit Texas Hold'em game server with bot API",
  "main": "dist/src/main.js",
  "scripts": {
    "prestart": "npm run build",
    "start": "node dist/src/main.js",
    "start:prod": "NODE_ENV=production node dist/src/main.js",
    "dev": "nest start --watch",
    "dev:debug": "nest start --watch --debug",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" && npm run lint --prefix frontend",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "ci:local": "./scripts/ci-local.sh",
    "ci:local:quick": "./scripts/ci-local.sh --quick",
    "ci:local:fix": "./scripts/ci-local.sh --fix",
    "test": "vitest run --exclude 'tests/e2e/**'",
    "test:watch": "vitest --exclude 'tests/e2e/**'",
    "test:cov": "vitest run --coverage",
    "test:cov:fast": "vitest run --coverage --exclude 'tests/e2e/**'",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:docker": "docker compose -f docker-compose.test.yml up --abort-on-container-exit --exit-code-from test",
    "test:db:setup": "npx ts-node scripts/setup-test-db.ts",
    "test:all": "vitest run",
    "typecheck": "tsc --noEmit --incremental false",
    "security:audit": "npm audit --audit-level=high",
    "security:audit:fix": "npm audit fix",
    "preinstall": "npm audit --audit-level=critical || true",
    "license:check": "license-checker --onlyAllow 'MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;CC0-1.0;CC-BY-4.0;CC-BY-3.0;Unlicense;Python-2.0;BlueOak-1.0.0;MPL-2.0' --excludePrivatePackages",
    "prepare": "husky",
    "migration:run": "npm run build && node dist/src/migrations/run.js",
    "migration:generate": "npm run build && npx typeorm migration:generate -d dist/src/config/typeorm.config.js",
    "migration:revert": "npm run build && npx typeorm migration:revert -d dist/src/config/typeorm.config.js",
    "migration:show": "npm run build && npx typeorm migration:show -d dist/src/config/typeorm.config.js",
    "db:drop": "npm run build && npx typeorm schema:drop -d dist/src/config/typeorm.config.js",
    "seed:tournaments": "npx ts-node scripts/seed-tournaments.ts",
    "seed:system-bots": "npx ts-node scripts/seed-system-bots.ts",
    "tournament:quick-start": "npx ts-node scripts/tournament-quick-start.ts",
    "game:watch": "bash scripts/watch-live-game.sh",
    "test:poker": "npx ts-node --transpile-only scripts/run-poker-tests.ts",
    "bugs:detect": "npx ts-node src/testing-utilities/ui-bug-reporter.ts",
    "audit:games": "npx ts-node --transpile-only scripts/audit-games.ts",
    "audit:bots": "npx ts-node --transpile-only scripts/audit-bots.ts",
    "battle:lab": "npx ts-node --transpile-only scripts/battle-lab.ts"
  },
  "keywords": [
    "poker",
    "texas-holdem",
    "bot",
    "game-engine"
  ],
  "license": "MIT",
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.665.0",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.18",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/platform-socket.io": "^11.1.18",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "@nestjs/websockets": "^11.1.18",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^8.0.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "pokersolver": "^2.1.4",
    "redis": "^5.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.2",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.28",
    "typescript": "^6.0.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.17",
    "@nestjs/testing": "^11.1.18",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.5.2",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "license-checker": "^25.0.1",
    "lint-staged": "^16.4.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "picomatch": "^4.0.4",
    "path-to-regexp": "^8.4.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/swagger": {
      "path-to-regexp": "^8.4.0"
    },
    "@nestjs/cli": {
      "picomatch": "^4.0.4"
    }
  }
}
