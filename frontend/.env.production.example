# =============================================================
# BotRoyale Frontend — Production Environment (Vercel)
# Set these as Environment Variables in the Vercel dashboard.
# Scope: Production only.
# =============================================================

# The public API base URL (your domain behind Cloudflare).
# Do NOT add /api/v1 suffix — the axios client appends that.
# Do NOT add trailing slash.
VITE_API_URL=https://api.yourdomain.com

# Optional: Sentry DSN for production error tracking
# VITE_SENTRY_DSN=https://xxxxx@oyyy.ingest.sentry.io/zzzz
